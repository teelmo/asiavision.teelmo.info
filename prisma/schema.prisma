generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Country {
  id      Int      @id @default(autoincrement())
  code    String   @unique
  name    String
  flag    String
  order   Int      @default(0)
  entries VoteEntry[]
}

model Voter {
  id        Int      @id @default(autoincrement())
  name      String
  token     String   @unique
  hasVoted  Boolean  @default(false)
  createdAt DateTime @default(now())
  vote      Vote?
}

model Vote {
  id        Int         @id @default(autoincrement())
  voter     Voter       @relation(fields: [voterId], references: [id], onDelete: Cascade)
  voterId   Int         @unique
  createdAt DateTime    @default(now())
  entries   VoteEntry[]
}

model VoteEntry {
  id        Int     @id @default(autoincrement())
  vote      Vote    @relation(fields: [voteId], references: [id], onDelete: Cascade)
  voteId    Int
  country   Country @relation(fields: [countryId], references: [id])
  countryId Int
  points    Int

  @@unique([voteId, countryId])
}

// Singleton row (id always 1) holding poll-wide state.
model PollSettings {
  id             Int     @id @default(1)
  voterThreshold Int     @default(0)
  isFinalized    Boolean @default(false)
  isRevealed     Boolean @default(false)
}
